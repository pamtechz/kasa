{
  "name": "kasa-enrollment-network",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "bootstrap": "node scripts/bootstrap-admin.mjs",
    "seed": "node scripts/seed-forms.mjs",
    "seed:catalog": "node scripts/seed-catalog.mjs",
    "test:source": "node --experimental-strip-types --test scripts/tests/*.test.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "doctor": "node scripts/doctor.mjs",
    "doctor:firebase": "node --env-file=.env.local scripts/firebase-env-doctor.mjs",
    "clean:next": "node scripts/clean-next-cache.mjs",
    "dev:3001": "node scripts/dev.mjs 3001",
    "clean:next:confirm": "node scripts/clean-next-cache.mjs --yes"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "firebase": "^12.0.0",
    "firebase-admin": "13.10.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.28",
    "fake-indexeddb": "6.2.6",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "postcss": "8.5.31"
  }
}
