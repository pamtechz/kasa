rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Six roles: super_admin, admin, reviewer, finance, agent and student.
  // A custom JWT role claim is NOT authoritative. Only active profiles
  // maintained by the server confer role privileges.
  function signedIn(){return request.auth != null;}
  function verified(){return signedIn() && request.auth.token.email_verified == true;}
  function currentProfile(){
   return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
  }
  function activeRole(roles){
   return verified() &&
    exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
    currentProfile().active == true &&
    currentProfile().role in roles;
  }
  function contentReader(){
   return activeRole(['super_admin','admin','reviewer']);
  }
  function ownProfile(uid){
   return verified() && request.auth.uid == uid;
  }

  // A user may see only their own account data. All identity, role, active,
  // security and permission changes MUST go through audited server APIs.
  match /profiles/{uid} {
   allow get: if ownProfile(uid) && resource.data.active == true;
   allow list, create, update, delete: if false;
  }

  // Published public catalogue is readable anonymously.
  // Authenticated, active staff/reviewers may inspect drafts from the SDK.
  // All writes stay server-only so form versions and audit trails are enforced.
  match /forms/{id} {
   allow get,list: if resource.data.published == true || contentReader();
   allow create,update,delete: if false;
  }
  match /programmes/{id} {
   allow get,list: if resource.data.published == true || contentReader();
   allow create,update,delete: if false;
  }
  match /announcements/{id} {
   allow get,list: if resource.data.published == true || contentReader();
   allow create,update,delete: if false;
  }
  match /adCampaigns/{id} {
   allow get,list: if resource.data.active == true || contentReader();
   allow create,update,delete: if false;
  }

  // Deliberately server-only: these contain private fields, financial
  // evidence, anonymous applicant documents or shared notification bodies.
  // Firestore rules cannot redact individual fields of a readable document.
  // Staff/reviewers/agents/students/finance use scoped authenticated APIs,
  // which perform field-level filtering, workflow validation and audit logs.
  match /submissions/{id} {allow read,write: if false;}
  match /applicationDedupe/{id} {allow read,write: if false;}
  match /fileClaims/{id} {allow read,write: if false;}
  match /notificationOutbox/{id} {allow read,write: if false;}
  match /fundingVerifications/{id} {allow read,write: if false;}
  match /commissionPayments/{id} {allow read,write: if false;}
  match /settings/{id} {allow read,write: if false;}
  match /rateLimits/{id} {allow read,write: if false;}
  match /auditLogs/{id} {allow read,write: if false;}
  match /agentPayoutRequests/{id} {allow read,write: if false;}

  // Any other present or future collection is private by default.
  match /{document=**} {allow read,write: if false;}
 }
}
