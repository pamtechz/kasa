rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The KASA Next.js server uses the Firebase Admin SDK. Admin SDK calls
    // bypass security rules and must authenticate and authorize every request.
    // Browsers must not create admissions, approvals, invoices or notifications.
    function ownAccount(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /profiles/{uid} {
      allow get: if ownAccount(uid);
      allow list, create, update, delete: if false;
    }

    match /forms/{id} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
    match /programmes/{id} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
    match /announcements/{id} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
    match /adCampaigns/{id} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    // Covers submissions, settings, fileClaims, applicationDedupe,
    // notificationOutbox, finances, rateLimits, audit logs and future paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
