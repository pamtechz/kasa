rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public branding assets may be read by anyone. Uploads still go through
    // authenticated server routes using the Firebase Admin SDK.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Private staging documents, CDF evidence and submission attachments
    // are accessible only through authorized backend endpoints.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
