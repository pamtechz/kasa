# Firebase Web app identifiers (public values, not service-account secrets).
# On localhost copy this file to .env.local and fill in the Firebase Console web SDK values.
# Vercel environment variables do not automatically populate local .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Required on production; local next dev bypasses server-side App Check.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Server-only Firebase Admin credentials. Use an uncommitted .env.local for local testing,
# and secure Vercel environment variables only when a deployment is authorized.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Origin for CSRF/origin validation, e.g. https://your-app.vercel.app
APP_URL=http://localhost:3000
# at least 32 random characters, unrelated to Firebase credentials
RATE_LIMIT_SALT=
# For bootstrap script only
BOOTSTRAP_ADMIN_EMAIL=

# Intake opening and closing are stored in Firestore settings/intake; no environment toggle.
