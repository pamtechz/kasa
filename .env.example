# Firebase WEB app config (public values, not service account)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Server-only Firebase Admin credentials, store exclusively in Vercel secrets.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Origin for CSRF/origin validation, e.g. https://your-app.vercel.app
APP_URL=http://localhost:3000
# at least 32 random characters, unrelated to Firebase credentials
RATE_LIMIT_SALT=
# For bootstrap script only
BOOTSTRAP_ADMIN_EMAIL=

# Explicit launch gate: leave false until Firebase rules, forms, authentication and intake operations are verified.
KASA_APPLICATIONS_ENABLED=false
